{
  "buildCommand": "prisma generate && prisma db push --accept-data-loss && next build",
  "framework": "nextjs",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/cron/collecte",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/news",
      "schedule": "0 8 * * *"
    }
  ]
}
