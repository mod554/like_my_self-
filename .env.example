# ─── Base de données ──────────────────────────────────────────────────────────
# PostgreSQL — exemple local
DATABASE_URL="postgresql://user:password@localhost:5432/terminal_agri?schema=public"

# ─── Auth (NextAuth.js) ───────────────────────────────────────────────────────
NEXTAUTH_SECRET="changez-moi-en-production-32-chars-min"
NEXTAUTH_URL="http://localhost:3000"

# ─── Taux de change ───────────────────────────────────────────────────────────
# Optionnel — API gratuite pour taux USD/EUR du jour
# Exemple : https://api.exchangerate-api.com/v4/latest/USD (gratuit, pas de clé requise)
# EXCHANGE_RATE_API_KEY=""

# Scraping Firecrawl (https://www.firecrawl.dev) — optionnel mais recommandé.
# Débloque SIMAGRI-CI et Selina Wamucii depuis Vercel (leurs boucliers anti-bot
# renvoient 403 aux IP Vercel) et remplace les regex HTML par de l'extraction
# structurée. Sans cette clé, ces deux sources restent collectées par le runner
# GitHub Actions : rien ne casse, mais le scraping garde ses fragilités.
FIRECRAWL_API_KEY=fc-...
# Alternative : instance Firecrawl auto-hébergée (docker compose du dépôt
# firecrawl, API sur le port 3002). Démarrée avec USE_DB_AUTHENTICATION=false,
# elle ne valide aucune clé — définir FIRECRAWL_API_URL SEULE suffit alors,
# FIRECRAWL_API_KEY peut rester vide.
# FIRECRAWL_API_URL=https://votre-instance-firecrawl.example.com
