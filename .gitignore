# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.local
.env.*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# ─── Sous-projet Python BRVM (brvm/) ──────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Configuration renseignée par l'utilisateur : contient son barème de frais et
# ses paramètres fiscaux. Seuls les fichiers *.exemple.* sont versionnés.
brvm/config/config.yaml
brvm/config/jours_feries.yaml
brvm/config/univers.csv

# Base de données locale, journaux et fichiers de cotations
brvm/data/

# Artefacts des tests (chemins relatifs de la configuration de test)
donnees_test/
